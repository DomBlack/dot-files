#!/usr/bin/env python3
"""chezmoi modify script: merge tmux agent-state hooks and fixed settings into ~/.claude/settings.json.

Receives current file contents on stdin, writes merged contents to stdout.
Idempotent: skips any hook command already present and only overwrites the
fixed settings listed in SETTINGS.
"""
import json
import os
import sys

SCRIPT = "$HOME/.config/tmux/scripts/agent-state.sh"
WANTED = {
    "UserPromptSubmit": f"{SCRIPT} working",
    "PreToolUse": f"{SCRIPT} working",
    "Notification": f"{SCRIPT} input",
    "Stop": f"{SCRIPT} done",
    "SessionEnd": f"{SCRIPT} clear",
}

# Settings enforced on every machine. Empty attribution strings stop Claude
# Code appending Co-Authored-By trailers to commits and the generated-with
# footer to PR descriptions. In-process teammates keep named agents inside the
# session instead of opening a tmux pane each; the monitor mod shows them.
SETTINGS = {
    "attribution": {"commit": "", "pr": ""},
    "teammateMode": "in-process",
}

# The monitor mod lives in ~/.claude/mods, a folder marketplace chezmoi ships;
# listing it here makes Claude Code register the marketplace and enable the
# plugin on every machine without a manual install.
MODS_DIR = os.path.expanduser("~/.claude/mods")
MARKETPLACES = {
    "dom-mods": {"source": {"source": "directory", "path": MODS_DIR}},
}
PLUGINS = {
    "monitor@dom-mods": True,
}

raw = sys.stdin.read()
try:
    data = json.loads(raw) if raw.strip() else {}
except json.JSONDecodeError:
    # Never corrupt the live settings: emit input unchanged and skip merging
    sys.stdout.write(raw)
    sys.exit(0)

if not isinstance(data, dict):
    # Never corrupt the live settings: emit input unchanged and skip merging
    sys.stdout.write(raw)
    sys.exit(0)

hooks = data.setdefault("hooks", {})
for event, command in WANTED.items():
    groups = hooks.setdefault(event, [])
    existing = [
        h.get("command")
        for g in groups
        for h in g.get("hooks", [])
        if h.get("type") == "command"
    ]
    if command not in existing:
        groups.append({"hooks": [{"type": "command", "command": command}]})

for key, value in SETTINGS.items():
    data[key] = value

marketplaces = data.setdefault("extraKnownMarketplaces", {})
for name, entry in MARKETPLACES.items():
    marketplaces.setdefault(name, entry)

plugins = data.setdefault("enabledPlugins", {})
for name, enabled in PLUGINS.items():
    plugins.setdefault(name, enabled)

json.dump(data, sys.stdout, indent=2)
sys.stdout.write("\n")
